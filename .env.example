# --- Seguridad (obligatorias: sin ellas el servidor rechaza las peticiones) ---
# Clave que Vapi envía en el encabezado x-vapi-secret (la misma que pones en "Server URL secret")
VAPI_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# Clave para entrar al dashboard del técnico
DASHBOARD_TOKEN=cambia-esto-por-otra-clave-larga-y-aleatoria

# --- Farmacia ---
PHARMACY_NAME=Nombre de la Farmacia
# URL pública del dashboard (se incluye en la alerta de WhatsApp)
DASHBOARD_URL=https://tu-app.up.railway.app

# --- Alertas por WhatsApp (opcional; sin esto Sofía funciona pero no avisa por WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp de Twilio, con +. Ej: +1939XXXXXXX
TWILIO_WHATSAPP_NUMBER=
# Quién recibe las alertas (uno o varios, separados por coma). Ej: +1787XXXXXXX
ALERT_WHATSAPP_TO=
# Plantilla de WhatsApp APROBADA en Twilio (recomendado en producción; sin ella, WhatsApp solo entrega el texto si el
# destinatario escribió al número en las últimas 24 h). Cuerpo sugerido de la plantilla, categoría Utility:
#   Sofía RX: {{1}} — {{2}}. Tel: {{3}}. Detalle: {{4}}
TWILIO_CONTENT_SID=

# --- Opcionales ---
# PORT lo pone Railway automáticamente
# Dónde se guardan los pendientes. En Railway, monta un Volume en /data y usa /data/pendientes.json
DATA_FILE=./data/pendientes.json
# Días que se conservan los pendientes antes de borrarse (por defecto 30)
RETENTION_DAYS=30
# Si el dashboard vive en otro dominio (ej. Vercel), su origen exacto. Ej: https://sofia-rx.vercel.app
CORS_ORIGIN=
